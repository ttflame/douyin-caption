APP_ENV=development
APP_SECRET_KEY=replace-with-at-least-32-random-characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KEY_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
# Temporary migration escape hatch only; remove after replacing all member API keys.
ALLOW_LEGACY_WEAK_KEY_ENCRYPTION_SECRET=false
DATABASE_URL=postgresql+asyncpg://caption:caption@localhost:5432/caption
REDIS_URL=redis://localhost:6379/0
# Development-only single-process fallback. Production rejects true at startup.
ALLOW_IN_MEMORY_COORDINATION=false
CORS_ORIGINS=["http://localhost:5173"]

# Used only by the one-time `bootstrap-admin` command. Remove the password after use.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=set-in-the-process-environment-only
